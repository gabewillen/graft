   "request": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "SendMessage",
    "params": {
     "message": {
      "messageId": "u1",
      "role": "ROLE_USER",
      "parts": [
       {
        "text": "Hi"
       }
      ]
     }
    }
   },
   "expect": {
    "jsonrpc": "2.0",
    "id": 1,
    "result": {
